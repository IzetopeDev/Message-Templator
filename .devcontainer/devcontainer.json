{
	"name": "Flutter Dev Container",
	"build": {
		"dockerfile": "../Dockerfile",
		"context": ".."
	},
	
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			// Add the IDs of extensions you want installed when the container is created.
			// Satisfies Requirement 1 & 1a: Full Flutter/Dart IDE support
			"extensions": [
				"Dart-Code.flutter",
				"Dart-Code.dart-code",
				"alexisvt.flutter-snippets",
				"nash.awesome-flutter-snippets"
			],
			"settings": {
				// Tell VS Code where to find the Flutter SDK inside the container
				"dart.flutterSdkPath": "/home/vscode/flutter",
				// Enable formatting on save for Dart
				"[dart]": {
					"editor.formatOnSave": true,
					"editor.formatOnType": true,
					"editor.rulers": [80],
					"editor.selectionHighlight": false,
					"editor.suggest.snippetsPreventQuickSuggestions": false,
					"editor.suggestSelection": "first",
					"editor.tabCompletion": "onlySnippets",
					"editor.wordBasedSuggestions": "off"
				}
			}
		}
	},

	// Forward ports for web development (standard Flutter web port)
	// Satisfies Requirement 3: Running on Web
	"forwardPorts": [8080],

	// Grants the container access to USB devices (required for ADB debugging with physical devices)
	// Satisfies Requirement 4: Running on ADB (USB Passthrough)
	// Note: On Windows/macOS, USB passthrough has limitations. ADB over TCP/IP is often a good backup.
	"runArgs": [
		"--privileged",
		"-v",
		"/dev/bus/usb:/dev/bus/usb"
	],

	// Use 'postCreateCommand' to run commands after the container is created.
	// Satisfies Requirement 2: Git Versioning (Fixes 'dubious ownership' errors)
	"postCreateCommand": "git config --global --add safe.directory '*' && flutter doctor && flutter pub get",

	// Connect as the non-root user defined in the Dockerfile
	"remoteUser": "vscode"
}