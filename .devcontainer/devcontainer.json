{
	"name": "Flutter Dev Container",
	"build": {
		"dockerfile": "../Dockerfile",
		"context": ".."
	},
	
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			// Add the IDs of extensions you want installed when the container is created.
			// Satisfies Requirement 1 & 1a: Full Flutter/Dart IDE support
			"extensions": [
				"Dart-Code.flutter",
				"Dart-Code.dart-code",
				"alexisvt.flutter-snippets",
				"nash.awesome-flutter-snippets"
			],
			"settings": {
				// Tell VS Code where to find the Flutter SDK inside the container
				"dart.flutterSdkPath": "/home/vscode/flutter",
				// Enable formatting on save for Dart
				"[dart]": {
					"editor.formatOnSave": true,
					"editor.formatOnType": true,
					"editor.rulers": [80],
					"editor.selectionHighlight": false,
					"editor.suggest.snippetsPreventQuickSuggestions": false,
					"editor.suggestSelection": "first",
					"editor.tabCompletion": "onlySnippets",
					"editor.wordBasedSuggestions": "off"
				}
			}
		}
	},

	// Forward ports for development
	// 8080: Flutter Web
	// 5554: Android Emulator Console (Telnet)
	// 5555: Android Emulator ADB Port (TCP)
	"forwardPorts": [8080, 5554, 5555],

	// Labels for the forwarded ports in the VS Code 'Ports' view
	"portsAttributes": {
		"8080": {
			"label": "Flutter Web App",
			"onAutoForward": "openBrowser"
		},
		"5554": {
			"label": "Emulator Console"
		},
		"5555": {
			"label": "ADB Connection"
		}
	},

	// Grants the container access to USB devices (required for ADB debugging with physical devices)
	// Satisfies Requirement 4: Running on ADB (USB Passthrough)
	"runArgs": [
		"--privileged",
		"-v",
		"/dev/bus/usb:/dev/bus/usb"
	],

	// Use 'postCreateCommand' to run commands after the container is created.
	// Satisfies Requirement 2: Git Versioning (Fixes 'dubious ownership' errors)
	"postCreateCommand": "/home/vscode/container_config/start.sh",

	// Connect as the non-root user defined in the Dockerfile
	"remoteUser": "vscode"
}