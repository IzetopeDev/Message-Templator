{
	"name": "Flutter Dev Container",
	"build": {
		"dockerfile": "../Dockerfile",
		"context": ".."
	},
	
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			// Add the IDs of extensions you want installed when the container is created.
			// Satisfies Requirement 1 & 1a: Full Flutter/Dart IDE support
			"extensions": [
				"Dart-Code.flutter",
				"Dart-Code.dart-code",
				"alexisvt.flutter-snippets",
				"nash.awesome-flutter-snippets"
			],
			"settings": {
				// Tell VS Code where to find the Flutter SDK inside the container
				"dart.flutterSdkPath": "/home/vscode/flutter",
				// Enable formatting on save for Dart
				"[dart]": {
					"editor.formatOnSave": true,
					"editor.formatOnType": true,
					"editor.rulers": [80],
					"editor.selectionHighlight": false,
					"editor.suggest.snippetsPreventQuickSuggestions": false,
					"editor.suggestSelection": "first",
					"editor.tabCompletion": "onlySnippets",
					"editor.wordBasedSuggestions": "off"
				}
			}
		}
	},

	// Forward ports for development
	// 8080: Flutter Web
	// 5554: Android Emulator Console (Telnet)
	// 5555: Android Emulator ADB Port (TCP)
	"forwardPorts": [8080, 5554, 5555],

    "portsAttributes": {
        "8080": {
            "label": "Flutter Web App",
            "onAutoForward": "openBrowser"
        },
        "5555": {
            "label": "ADB Connection"
        }
    },

    // CRITICAL: This tells the container "Don't look for USBs inside Linux. 
    // Talk to the Windows ADB Server on port 5037."
    "containerEnv": {
        "ADB_SERVER_SOCKET": "tcp:host.docker.internal:5037"
    },

    // Cleaned up: Removed the Linux-specific USB mounting args
    "runArgs": [],

    "postCreateCommand": "/home/vscode/container_config/start.sh",

	// Connect as the non-root user defined in the Dockerfile
	"remoteUser": "vscode"
}